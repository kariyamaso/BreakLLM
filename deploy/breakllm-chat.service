[Unit]
Description=BreakLLM OpenUI research chat and comparison report
After=network-online.target

[Service]
WorkingDirectory=/home/ubuntu/kariyama/BreakLLM
Environment=PYTHONPATH=/home/ubuntu/kariyama/BreakLLM/src
# Keep the resident default light on the shared GPU: Qwen3-1.7B (~4GB) loads at
# startup and its trained escalation artifacts (soft/mse/gcg/pair/autodan) work.
# Qwen3.8-27B (qwen3_5 arch, ~56GB bf16) is selectable on demand; with
# BREAKLLM_MAX_LOADED=1 it loads only when a request selects it and evicts 1.7B,
# so the GPU is not held at 56GB unless the 27B is actually in use.
Environment=BREAKLLM_MODEL=Qwen/Qwen3-1.7B
Environment=BREAKLLM_MODELS=Qwen/Qwen3.8-27B
Environment=BREAKLLM_DEVICE=cuda
Environment=HF_HUB_OFFLINE=1
ExecStart=/home/ubuntu/kariyama/BreakLLM/.venv/bin/uvicorn heretic.chat_service.app:app --host 100.91.77.114 --port 8768 --loop asyncio
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
